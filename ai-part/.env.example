# ==============================================================================
# Bahrain Statistical AI Agent - Environment Configuration Example
# Copy this file to '.env' and populate the required credentials.
# ==============================================================================

# --- API Keys & Credentials ---
# Required for OpenAI fallback and refinement features.
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Model name to use. Recommended: gpt-4o-mini or gpt-4
OPENAI_MODEL=gpt-4o-mini

# (Optional) Timeout for OpenAI API calls in seconds (Default: 10)
OPENAI_TIMEOUT=10

# (Optional) Word limit to skip LLM processing for very short responses (Default: 5)
LLM_MIN_WORDS=5

# --- Web Search fallback config ---
# (Optional) SerpAPI Key to fetch latest data snippet context
SEARCH_API_KEY=your_serpapi_key_here
SEARCH_ENGINE=serpapi

# (Optional) Microsoft Bing Search API config fallback
BING_SUBSCRIPTION_KEY=your_bing_sub_key_here
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# --- Ingestion Webhook configurations ---
# Secret token required to post data payload to /ingest (Required for webhook)
WEBHOOK_SECRET=generate_a_secure_random_string_here

# (Optional) Path to incoming uploads (Default: data/incoming)
INCOMING_DIR=data/incoming

# (Optional) Ingest dry run configuration. Set to 0 to enable write mode.
INGEST_DRY=1

# --- Fetch configurations ---
FETCH_MAX_RETRIES=3
FETCH_RETRY_BACKOFF=5
FETCH_CHUNK_SIZE=8192
FETCH_MAX_DOWNLOAD_BYTES=52428800
REPLACE_DUPLICATES=1

# --- App Settings ---
# Base path where Parquet and CSV master datasets are placed
BAHRAIN_DATA_PATH=data/bahrain_master

# How long to cache plot configurations (Default: 30 seconds)
CHART_CACHE_TTL_SECONDS=30

# Port on which Gradio Web UI runs (Default: 7860)
GRADIO_PORT=7860
